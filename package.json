{
  "name": "appium-wdio-android",
  "version": "1.0.0",
  "private": true,
  "description": "Android mobile automation with WebdriverIO + Appium",
  "scripts": {
    "apk:download": "node ./scripts/download-apk.mjs",
    "appium:driver": "appium driver install uiautomator2",
    "postinstall": "npm run appium:driver || echo \"uiautomator2 driver install skipped\"",
    "test:android": "wdio run wdio.conf.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.18.0",
    "@wdio/appium-service": "^9.18.0",
    "@wdio/cli": "^9.18.0",
    "@wdio/local-runner": "^9.18.0",
    "@wdio/mocha-framework": "^9.18.0",
    "@wdio/spec-reporter": "^9.18.0",
    "allure-commandline": "^2.34.1",
    "appium": "^3.0.1",
    "appium-uiautomator2-driver": "^7.1.2",
    "expect-webdriverio": "^5.4.1"
  }
}
