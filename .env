# ============================================
# ANDROID SDK CONFIGURATION
# ============================================
# Path tới Android SDK installation
# Nếu không set, wdio.conf.js sẽ use default Windows path
ANDROID_HOME=C:\Users\YOUR_USER\AppData\Local\Android\Sdk

# ============================================
# EMULATOR CONFIGURATION
# ============================================
# Platform name (Android / iOS)
PLATFORM_NAME=Android

# Tên device emulator
DEVICE_NAME=Android Emulator

# Platform version của emulator
PLATFORM_VERSION=14.0

# ============================================
# REAL DEVICE CONFIGURATION (REALME 5)
# ============================================
# Unique Device ID của Realme 5
# Lấy bằng: adb devices
# Format: <serial-number> device (e.g., 673bb926)
UDID=673bb926

# Platform version của Realme 5
REALME_PLATFORM_VERSION=10.0

# ============================================
# APPIUM SETTINGS
# ============================================
# Port mà Appium server chạy
APPIUM_PORT=4723

# Log level: quiet, silent, warn, error, verbose, debug
LOG_LEVEL=error

# ============================================
# TEST EXECUTION MODE
# ============================================
# Set to "true" để chạy test trên real device (Realme 5)
# Mặc định: "false" (chạy trên emulator)
RUN_ON_REAL_DEVICE=true

]

# ============================================
# BROWSERSTACK CONFIGURATION
# ============================================
# BrowserStack credentials
BROWSERSTACK_USERNAME=phmthnht_3LeHuV
BROWSERSTACK_ACCESS_KEY=gz2PVpoyytrfGcuL12qA

# BrowserStack app URL (App Automate upload URL)
BROWSERSTACK_APP_URL=bs://<app-id>

# BrowserStack device settings
BROWSERSTACK_PLATFORM_NAME=Android
BROWSERSTACK_PLATFORM_VERSION=14.0
BROWSERSTACK_DEVICE_NAME=Google Pixel 7
BROWSERSTACK_PROJECT=Appium WebdriverIO
BROWSERSTACK_BUILD=BrowserStack Appium Build
BROWSERSTACK_SESSION=Appium BrowserStack Session
BROWSERSTACK_LOCAL=false

# ============================================
# iOS SPECIFIC (For Future Use)
# ============================================
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.0
IOS_UDID=auto

